+++ b/src/feature-overrides.css
@@ -0,0 +1,186 @@
+/* 오늘의 시간표/급식 메뉴 + 학사일정 표시 가독성 개선 */
+.home-actions-three {
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.home-actions-three .home-menu-button:nth-child(1) {
+  background: linear-gradient(180deg, #f5edff, #fffdf9);
+}
+
+.home-actions-three .home-menu-button:nth-child(2) {
+  background: linear-gradient(180deg, #eaf8ff, #fffdf9);
+}
+
+.home-actions-three .home-menu-button:nth-child(3) {
+  background: linear-gradient(180deg, #fff3df, #fffdf9);
+}
+
+.home-actions-three .home-menu-button strong {
+  font-size: clamp(1.22rem, 2.25dvh, 1.9rem);
+  text-align: center;
+}
+
+.home-actions-three .home-menu-icon {
+  width: clamp(56px, 8dvh, 84px);
+  font-size: clamp(2rem, 4dvh, 3.15rem);
+}
+
+.simple-info-page {
+  grid-template-rows: auto minmax(0, 1fr);
+}
+
+.daily-info-panel {
+  min-height: 0;
+  padding: clamp(22px, 3dvh, 36px);
+  overflow: hidden;
+}
+
+.timetable-list {
+  display: grid;
+  align-content: start;
+  gap: clamp(12px, 1.8dvh, 18px);
+  height: 100%;
+  margin: 0;
+  padding: 0 6px 0 0;
+  overflow-y: auto;
+  list-style: none;
+  scrollbar-width: thin;
+  scrollbar-color: #9bc7df transparent;
+}
+
+.timetable-list li {
+  display: grid;
+  grid-template-columns: minmax(84px, 0.28fr) minmax(0, 1fr);
+  align-items: center;
+  gap: 18px;
+  min-height: clamp(76px, 10dvh, 110px);
+  padding: 14px 20px;
+  border: 1px solid rgba(71, 123, 153, 0.12);
+  border-radius: 20px;
+  background: linear-gradient(90deg, #eef8ff, #fffdf9 48%);
+}
+
+.period-badge {
+  display: grid;
+  place-items: center;
+  min-height: 50px;
+  padding: 8px 12px;
+  border-radius: 16px;
+  background: #d9effb;
+  color: #245f7f;
+  font-size: clamp(1.05rem, 2dvh, 1.45rem);
+  font-weight: 900;
+}
+
+.timetable-list strong {
+  min-width: 0;
+  font-size: clamp(1.55rem, 3dvh, 2.45rem);
+  line-height: 1.18;
+}
+
+.meal-panel {
+  display: grid;
+  grid-template-rows: auto minmax(0, 1fr);
+  gap: clamp(18px, 2.6dvh, 28px);
+  background: linear-gradient(145deg, rgba(255, 239, 210, 0.6), rgba(255, 253, 249, 0.96) 48%);
+}
+
+.meal-date {
+  justify-self: start;
+  margin: 0;
+  padding: 8px 14px;
+  border-radius: 999px;
+  background: #ffe7b8;
+  color: #79551f;
+  font-size: clamp(1rem, 1.9dvh, 1.35rem);
+  font-weight: 900;
+}
+
+.meal-menu {
+  display: grid;
+  align-content: center;
+  gap: clamp(12px, 2dvh, 20px);
+  min-height: 0;
+  margin: 0;
+  padding: 0;
+  overflow-y: auto;
+  list-style: none;
+  text-align: center;
+}
+
+.meal-menu li {
+  position: relative;
+  padding: 0 20px;
+  font-size: clamp(1.5rem, 3.1dvh, 2.5rem);
+  font-weight: 800;
+  line-height: 1.16;
+}
+
+.meal-menu li + li::before {
+  content: '';
+  position: absolute;
+  top: calc(-1 * clamp(7px, 1dvh, 10px));
+  left: 50%;
+  width: 34px;
+  height: 2px;
+  transform: translateX(-50%);
+  border-radius: 999px;
+  background: #efc986;
+}
+
+/* 기존 파스텔 색은 일정 카드에는 유지하고, 달력의 점만 진하게 표시한다. */
+.event-dots {
+  gap: 6px;
+  min-height: 14px;
+}
+
+.event-dots i {
+  width: 13px;
+  height: 13px;
+  border: 1px solid rgba(47, 42, 54, 0.18);
+  box-shadow: 0 0 0 2px rgba(255, 253, 249, 0.95), 0 2px 5px rgba(47, 42, 54, 0.18);
+}
+
+.event-dots .exam {
+  background: #7256d8;
+}
+
+.event-dots .event {
+  background: #e86f57;
+}
+
+.event-dots .vacation {
+  background: #31976f;
+}
+
+.event-dots .school {
+  background: #2e83bd;
+}
+
+.event-dots .etc {
+  background: #6f6975;
+}
+
+@media (max-width: 720px) {
+  .home-actions-three {
+    gap: 8px;
+  }
+
+  .home-actions-three .home-menu-button {
+    border-radius: 18px;
+  }
+
+  .home-actions-three .home-menu-button strong {
+    font-size: clamp(1rem, 2.1dvh, 1.35rem);
+  }
+
+  .home-actions-three .home-menu-button span:last-child {
+    font-size: 0.88rem;
+  }
+
+  .timetable-list li {
+    grid-template-columns: 76px minmax(0, 1fr);
+    gap: 12px;
+    padding: 12px 14px;
+  }
+}
